{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "callout",
  "type": "object",
  "additionalProperties": false,
  "required": ["variant", "body"],
  "properties": {
    "variant": { "enum": ["info", "tip", "warning", "danger", "example"] },
    "title": { "type": "string" },
    "body": { "type": "array" }
  }
}
