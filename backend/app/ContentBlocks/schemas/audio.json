{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audio",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    { "required": ["url"] },
    { "required": ["transcript"] }
  ],
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "transcript": { "type": "string" }
  }
}
