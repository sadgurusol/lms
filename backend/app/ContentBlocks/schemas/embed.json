{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "embed",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "url"],
  "properties": {
    "provider": { "enum": ["youtube", "vimeo", "geogebra", "desmos"] },
    "url": { "type": "string", "pattern": "^https://" },
    "title": { "type": "string" },
    "aspect_ratio": { "enum": ["16:9", "4:3", "1:1"] }
  }
}
