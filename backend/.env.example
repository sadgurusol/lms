APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=lms
DB_USERNAME=lms
DB_PASSWORD=secret
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63790

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cross-origin access for the learner app. Comma-separated; pin to your app
# origins in production. Defaults to "*" (dev only — never ship a wildcard).
CORS_ALLOWED_ORIGINS=*

# Payments (Razorpay). Without these, B2C checkout is disabled.
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI tutor. ANTHROPIC_API_KEY powers chat; VOYAGE_API_KEY enables retrieval
# (without it the tutor grounds on the course outline only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
# Per-learner monthly tutor token cap; blank = unlimited.
TUTOR_MONTHLY_TOKEN_BUDGET=

# Video. "local" (dev) leaves uploads in `processing` until `php artisan
# media:ready`; "mux" transcodes via Mux and calls the signed webhook.
MEDIA_TRANSCODER=local
MEDIA_WEBHOOK_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

VITE_APP_NAME="${APP_NAME}"
